# Database (used by app when running locally; Docker Compose overrides DATABASE_URL for the app)
DATABASE_URL="postgresql://user:password@localhost:5432/serfix?schema=public"

# PostgreSQL (used by Docker Compose for postgres service and to build DATABASE_URL for app)
POSTGRES_USER=serfix
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=serfix
POSTGRES_PORT=5432

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=1h

# Server
PORT=3000
NODE_ENV=production

# CORS (comma-separated origins; use * for dev only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
